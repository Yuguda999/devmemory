# DevMemory Configuration
# Copy this to .env and fill in your values

# ─── Deployment Mode ────────────────────────────────────────
# "saas" = multi-user with auth + tier enforcement
# "self-hosted" = single-user, no auth, no limits
DEVMEMORY_DEPLOYMENT_MODE=self-hosted

# ─── Database ───────────────────────────────────────────────
# SQLite (default for self-hosted):
DEVMEMORY_DATABASE_URL=sqlite+aiosqlite:///./devmemory.db

# PostgreSQL (recommended for SaaS):
# DEVMEMORY_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/devmemory

# ─── Auth ───────────────────────────────────────────────────
# Secret key for JWT tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
DEVMEMORY_SECRET_KEY=change-me-to-a-random-secret-key

# JWT token expiry in hours
DEVMEMORY_JWT_EXPIRY_HOURS=24

# ─── Server ─────────────────────────────────────────────────
DEVMEMORY_HOST=0.0.0.0
DEVMEMORY_PORT=8765
DEVMEMORY_LOG_LEVEL=INFO

# Public URL used in email links (verification, password reset). Must be
# browser-reachable — NOT 0.0.0.0. In SaaS set this to your app domain.
DEVMEMORY_APP_BASE_URL=http://localhost:8765

# ─── Email (optional) ───────────────────────────────────────
# Two backends, auto-selected: SendGrid HTTP API first (if key set), else SMTP.
# With neither set, emails are logged (not sent) and verification is NOT enforced.
#
# From identity — used by BOTH backends. For SendGrid single-sender this MUST be
# the verified sender address (e.g. your Gmail you verified in SendGrid).
# DEVMEMORY_SMTP_FROM_EMAIL=you@gmail.com
# DEVMEMORY_SMTP_FROM_NAME=DevMemory

# Option A — SendGrid HTTP API (recommended on Render; Render blocks SMTP ports).
# Create an API key with "Mail Send" permission, verify a Single Sender.
# DEVMEMORY_SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx

# Option B — SMTP (won't work on Render; fine for local / other hosts).
# DEVMEMORY_SMTP_HOST=smtp.gmail.com
# DEVMEMORY_SMTP_PORT=587
# DEVMEMORY_SMTP_USER=you@gmail.com
# DEVMEMORY_SMTP_PASSWORD=your-app-password
# DEVMEMORY_SMTP_USE_TLS=true       # STARTTLS on port 587
# DEVMEMORY_SMTP_USE_SSL=false      # implicit TLS on port 465

# Token lifetimes
# DEVMEMORY_EMAIL_VERIFICATION_EXPIRY_HOURS=24
# DEVMEMORY_PASSWORD_RESET_EXPIRY_MINUTES=30

# ─── Cardano payments (SaaS only) ──────────────────────────
# Free project id at https://blockfrost.io (match the network below).
# DEVMEMORY_BLOCKFROST_PROJECT_ID=preprod...
# Network: preprod | preview | mainnet. Use preprod for free test-ADA.
# DEVMEMORY_BLOCKFROST_NETWORK=preprod
# Your wallet ACCOUNT public key (Lace/Eternl → export account public key).
# The server derives a fresh receiving address per invoice from it.
# DEVMEMORY_CARDANO_ACCOUNT_XPUB=acct_xvk1...
# One-time upgrade prices, in whole ADA.
# DEVMEMORY_CARDANO_PRICE_PRO_ADA=10
# DEVMEMORY_CARDANO_PRICE_TEAM_ADA=30
# DEVMEMORY_CARDANO_INVOICE_EXPIRY_MINUTES=30
# DEVMEMORY_CARDANO_SUBSCRIPTION_DAYS=30
# DEVMEMORY_CARDANO_POLL_INTERVAL_SECONDS=30
# DEV ONLY — enables /simulate-paid to test upgrades without real ADA.
# DEVMEMORY_CARDANO_ALLOW_TEST_PAYMENTS=false
