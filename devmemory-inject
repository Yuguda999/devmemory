#!/usr/bin/env bash
# devmemory-inject — Auto-load DevMemory context into AI tool files on session start.
#
# Usage:
#   devmemory-inject [--cwd PATH] [--tool claude|augment|antigravity|generic] [--api-key KEY]
#
# What it does:
#   1. Calls the DevMemory REST API to get the resume prompt for the current project
#   2. Writes it to CLAUDE.md  (picked up automatically by Claude Code)
#   3. Writes it to .augment/rules/devmemory.md  (picked up automatically by Augment)
#   4. Prints a summary to stdout
#
# Configuration (in order of precedence):
#   --api-key FLAG > DEVMEMORY_API_KEY env var > ~/.devmemory/api_key file
#   --cwd FLAG    > current working directory ($PWD)
#   --tool FLAG   > "generic"

set -euo pipefail

# ── Defaults ──────────────────────────────────────────────────────────────────
CWD="${PWD}"
TOOL="generic"
API_KEY="${DEVMEMORY_API_KEY:-}"
HOST="${DEVMEMORY_HOST:-http://localhost:8765}"

# ── Parse args ─────────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --cwd)     CWD="$2";     shift 2 ;;
    --tool)    TOOL="$2";    shift 2 ;;
    --api-key) API_KEY="$2"; shift 2 ;;
    --host)    HOST="$2";    shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# ── Resolve API key ────────────────────────────────────────────────────────────
if [[ -z "$API_KEY" ]]; then
  KEY_FILE="$HOME/.devmemory/api_key"
  if [[ -f "$KEY_FILE" ]]; then
    API_KEY="$(cat "$KEY_FILE" | tr -d '[:space:]')"
  fi
fi

if [[ -z "$API_KEY" ]]; then
  echo "⚠️  devmemory-inject: No API key found." >&2
  echo "   Set DEVMEMORY_API_KEY, use --api-key, or create ~/.devmemory/api_key" >&2
  exit 0  # Exit 0 so hooks don't break the tool startup
fi

# ── Fetch context from REST API ────────────────────────────────────────────────
ENCODED_CWD=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))" "$CWD")
URL="${HOST}/context/resume?cwd=${ENCODED_CWD}&target_tool=${TOOL}"

RESPONSE=$(curl -s -f \
  -H "X-API-Key: ${API_KEY}" \
  "${URL}" 2>/dev/null) || {
  echo "⚠️  devmemory-inject: Could not reach DevMemory REST server at ${HOST}" >&2
  echo "   Start it with: devmemory --rest" >&2
  exit 0
}

# ── Parse response ─────────────────────────────────────────────────────────────
HAS_CONTEXT=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print('true' if d.get('has_context') else 'false')" 2>/dev/null || echo "false")

if [[ "$HAS_CONTEXT" != "true" ]]; then
  MSG=$(echo "$RESPONSE" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('message','No context available.'))" 2>/dev/null || echo "No context available.")
  echo "ℹ️  devmemory-inject: ${MSG}"
  exit 0
fi

PROMPT=$(echo "$RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin)['prompt'])" 2>/dev/null)
PROJECT=$(echo "$RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin).get('project','unknown'))" 2>/dev/null)
SESSION_TITLE=$(echo "$RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin).get('session_title',''))" 2>/dev/null)
BLOCK_COUNT=$(echo "$RESPONSE" | python3 -c "import sys,json; print(json.load(sys.stdin).get('block_count',0))" 2>/dev/null)

# ── Write to CLAUDE.md ─────────────────────────────────────────────────────────
CLAUDE_MD="${CWD}/CLAUDE.md"
cat > "$CLAUDE_MD" <<EOF
<!-- Auto-generated by devmemory-inject. Do not edit manually. -->
${PROMPT}
EOF

# ── Write to .augment/rules/devmemory.md ──────────────────────────────────────
AUGMENT_RULES_DIR="${CWD}/.augment/rules"
if [[ -d "${CWD}/.augment" ]] || [[ "$TOOL" == "augment" ]]; then
  mkdir -p "$AUGMENT_RULES_DIR"
  cat > "${AUGMENT_RULES_DIR}/devmemory.md" <<EOF
<!-- Auto-generated by devmemory-inject. Do not edit manually. -->
${PROMPT}
EOF
fi

# ── Summary ────────────────────────────────────────────────────────────────────
echo "✅ devmemory-inject: Loaded context for '${PROJECT}' — '${SESSION_TITLE}' (${BLOCK_COUNT} blocks)"
echo "   Written to: ${CLAUDE_MD}"
